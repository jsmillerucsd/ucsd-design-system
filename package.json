{
  "name": "ucsd-design-system",
  "version": "0.0.0",
  "private": true,
  "description": "UCSD Design System — token-first, framework-agnostic, LLM-readable. Successor to Decorator V5.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/tokens",
    "packages/bootstrap"
  ],
  "scripts": {
    "build": "npm run build:tokens && npm run build:bootstrap && npm run build:designmd && npm run build:skill && npm run build:figma-seed",
    "build:tokens": "npm run build --workspace @ucsd/tokens",
    "build:bootstrap": "npm run build --workspace @ucsd/bootstrap",
    "build:designmd": "node scripts/generate-design-md.mjs",
    "build:skill": "node scripts/generate-skill-references.mjs",
    "build:figma-seed": "node scripts/export-tokens-studio.mjs",
    "sync:figma": "node scripts/sync-figma.mjs",
    "test": "node --test test/*.test.mjs",
    "test:tokens": "node scripts/validate-tokens.mjs",
    "lint:designmd": "designmd lint DESIGN.md",
    "validate": "node skills/ucsd-design-system/scripts/validate.mjs"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0"
  }
}
