    "$description": "One 4px-based scale for margin, padding and gap. Numbers are multiples of 4 (space.4 = 16px). Deliberately NOT split into inset/stack/inline — that doubles the token count and every team invents a different rule for which to use."
  },
  "font": {
    "$description": "Roboto and Teko carried forward from Decorator V5; see docs/architecture.md open question 3.",
    "family": {
      "sans": {
        "$value": "Roboto, -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif",
