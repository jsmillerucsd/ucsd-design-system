{
  "radius": {
    "none":   { "$value": "0",     "$type": "dimension" },
    "sm":     { "$value": "2px",   "$type": "dimension" },
    "md":     { "$value": "4px",   "$type": "dimension" },
    "lg":     { "$value": "8px",   "$type": "dimension" },
    "xl":     { "$value": "16px",  "$type": "dimension" },
    "pill":   { "$value": "999px", "$type": "dimension" },
    "circle": { "$value": "50%",   "$type": "dimension" }
  },
  "elevation": {
    "0": { "$value": "none", "$type": "shadow" },
    "1": { "$value": "0 1px 2px 0 rgba(24, 43, 73, 0.08)",  "$type": "shadow" },
    "2": { "$value": "0 2px 6px 0 rgba(24, 43, 73, 0.10)",  "$type": "shadow" },
    "3": { "$value": "0 6px 16px 0 rgba(24, 43, 73, 0.12)", "$type": "shadow" },
    "4": { "$value": "0 12px 32px 0 rgba(24, 43, 73, 0.16)","$type": "shadow" }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "120ms", "$type": "duration" },
      "base": { "$value": "200ms", "$type": "duration" },
      "slow": { "$value": "320ms", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)", "$type": "cubicBezier" },
      "enter":    { "$value": "cubic-bezier(0, 0, 0, 1)",   "$type": "cubicBezier" },
      "exit":     { "$value": "cubic-bezier(0.3, 0, 1, 1)", "$type": "cubicBezier" }
    }
  },
  "breakpoint": {
    "$description": "MUST match Bootstrap 5 exactly (576/768/992/1200/1400) so Bootstrap utilities and Tailwind agree. A mismatch here produces bugs that take days to find.",
    "sm":  { "$value": "576px",  "$type": "dimension" },
    "md":  { "$value": "768px",  "$type": "dimension" },
    "lg":  { "$value": "992px",  "$type": "dimension" },
    "xl":  { "$value": "1200px", "$type": "dimension" },
    "xxl": { "$value": "1400px", "$type": "dimension" }
  },
  "container": {
    "$description": "Max content widths used by layouts/. 'prose' is the readable measure for long-form content pages (~70ch).",
    "prose": { "$value": "70ch",   "$type": "dimension" },
    "narrow":{ "$value": "768px",  "$type": "dimension" },
    "base":  { "$value": "1140px", "$type": "dimension" },
    "wide":  { "$value": "1320px", "$type": "dimension" }
  }
}
