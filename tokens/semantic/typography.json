{
  "font": {
    "$description": "Roboto and Teko carried forward from Decorator V5; see docs/architecture.md open question 3.",
    "family": {
      "sans":    { "$value": "Roboto, -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif", "$type": "fontFamily" },
      "display": { "$value": "Teko, Roboto, sans-serif", "$type": "fontFamily", "$description": "Condensed display face. Headings and hero type only — never body copy." },
      "mono":    { "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace", "$type": "fontFamily" }
    },
    "weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    }
  },
  "text": {
    "$description": "Type ramp. Each step carries size AND line-height so the two can never be mismatched. Steps are named by scale (md, lg, 2xl), never by HTML tag (h1) — an <h1> is not always the largest text on a page.",
    "xs":  { "size": { "$value": "12px", "$type": "dimension" }, "line-height": { "$value": "16px", "$type": "dimension" } },
    "sm":  { "size": { "$value": "14px", "$type": "dimension" }, "line-height": { "$value": "20px", "$type": "dimension" } },
    "md":  { "size": { "$value": "16px", "$type": "dimension" }, "line-height": { "$value": "24px", "$type": "dimension" }, "$description": "Body default." },
    "lg":  { "size": { "$value": "18px", "$type": "dimension" }, "line-height": { "$value": "28px", "$type": "dimension" } },
    "xl":  { "size": { "$value": "20px", "$type": "dimension" }, "line-height": { "$value": "28px", "$type": "dimension" } },
    "2xl": { "size": { "$value": "24px", "$type": "dimension" }, "line-height": { "$value": "32px", "$type": "dimension" } },
    "3xl": { "size": { "$value": "30px", "$type": "dimension" }, "line-height": { "$value": "36px", "$type": "dimension" } },
    "4xl": { "size": { "$value": "36px", "$type": "dimension" }, "line-height": { "$value": "40px", "$type": "dimension" } },
    "5xl": { "size": { "$value": "48px", "$type": "dimension" }, "line-height": { "$value": "52px", "$type": "dimension" } }
  }
}
