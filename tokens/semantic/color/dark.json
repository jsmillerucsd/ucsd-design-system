{
  "color": {
    "$description": "Semantic colors, Dark mode. Same token paths as light.json, re-aliased. Dark mode is a re-alias, never a new token — see docs/token-naming-contract.md.",
    "surface": {
      "default": { "$value": "{palette.navy.950}",   "$type": "color" },
      "subtle":  { "$value": "{palette.navy.900}",   "$type": "color" },
      "raised":  { "$value": "{palette.navy.800}",   "$type": "color" },
      "sunken":  { "$value": "{palette.black}",      "$type": "color" },
      "inverse": { "$value": "{palette.neutral.50}", "$type": "color" }
    },
    "text": {
      "default":    { "$value": "{palette.neutral.50}",  "$type": "color" },
      "muted":      { "$value": "{palette.neutral.300}", "$type": "color" },
      "subtle":     { "$value": "{palette.neutral.400}", "$type": "color" },
      "inverse":    { "$value": "{palette.navy.950}",    "$type": "color" },
      "link":       { "$value": "{palette.blue.300}",    "$type": "color", "$description": "Lightened: blue.500 fails AA on dark surfaces." },
      "link-hover": { "$value": "{palette.blue.200}",    "$type": "color" }
    },
    "border": {
      "default": { "$value": "{palette.navy.700}",    "$type": "color" },
      "subtle":  { "$value": "{palette.navy.800}",    "$type": "color" },
      "strong":  { "$value": "{palette.neutral.500}", "$type": "color" },
      "focus":   { "$value": "{palette.gold.500}",    "$type": "color", "$description": "Gold ring on dark: highest contrast option in the brand palette." }
    },
    "action": {
      "primary":          { "$value": "{palette.blue.400}",   "$type": "color" },
      "primary-hover":    { "$value": "{palette.blue.300}",   "$type": "color" },
      "primary-active":   { "$value": "{palette.blue.200}",   "$type": "color" },
      "secondary":        { "$value": "{palette.neutral.200}", "$type": "color" },
      "secondary-hover":  { "$value": "{palette.white}",      "$type": "color" },
      "secondary-active": { "$value": "{palette.white}",      "$type": "color" },
      "disabled":         { "$value": "{palette.navy.700}",   "$type": "color" }
    },
    "status": {
      "info":            { "$value": "{palette.blue.300}",  "$type": "color" },
      "info-subtle":     { "$value": "{palette.blue.900}",  "$type": "color" },
      "info-strong":     { "$value": "{palette.blue.100}",  "$type": "color" },
      "success":         { "$value": "{palette.green.500}", "$type": "color" },
      "success-subtle":  { "$value": "{palette.green.700}", "$type": "color" },
      "success-strong":  { "$value": "{palette.green.100}", "$type": "color" },
      "warning":         { "$value": "{palette.amber.500}", "$type": "color" },
      "warning-subtle":  { "$value": "{palette.amber.700}", "$type": "color" },
      "warning-strong":  { "$value": "{palette.amber.100}", "$type": "color" },
      "danger":          { "$value": "{palette.red.500}",   "$type": "color" },
      "danger-subtle":   { "$value": "{palette.red.700}",   "$type": "color" },
      "danger-strong":   { "$value": "{palette.red.100}",   "$type": "color" }
    },
    "brand": {
      "navy": { "$value": "{palette.navy.900}", "$type": "color" },
      "blue": { "$value": "{palette.blue.400}", "$type": "color" },
      "gold": { "$value": "{palette.gold.500}", "$type": "color" }
    }
  }
}
