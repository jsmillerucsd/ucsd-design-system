{
  "name": "@ucsd/tokens",
  "version": "0.1.0",
  "description": "UCSD design tokens compiled to CSS custom properties, Sass, Tailwind @theme, JS and JSON.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsmillerucsd/ucsd-design-system.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/js/tokens.js",
  "types": "./dist/js/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/js/tokens.d.ts",
      "default": "./dist/js/tokens.js"
    },
    "./full": "./dist/full.css",
    "./css": "./dist/css/tokens.css",
    "./scss": "./dist/scss/_tokens.scss",
    "./scss-dark": "./dist/scss/_tokens-dark.scss",
    "./tailwind": "./dist/tailwind/theme.css",
    "./shadcn": "./dist/shadcn/theme.css",
    "./json": "./dist/tokens.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "style-dictionary": "^4.3.0",
    "tailwindcss": "^4.3.3"
  }
}
